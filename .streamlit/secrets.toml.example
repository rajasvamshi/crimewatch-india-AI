# Copy to .streamlit/secrets.toml (git-ignored) and set CW_AUTH_MODE=oidc.
# Works with any OpenID Connect provider: NIC Parichay / Jan Parichay, Keycloak, Azure AD, etc.
[auth]
redirect_uri = "https://crimewatch.example.gov.in/oauth2callback"
cookie_secret = "generate-with: python -c 'import secrets; print(secrets.token_urlsafe(48))'"
client_id = "crimewatch"
client_secret = "from-your-identity-provider"
server_metadata_url = "https://sso.example.gov.in/realms/crimewatch/.well-known/openid-configuration"
