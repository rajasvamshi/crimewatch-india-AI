# Copy to .env (git-ignored). See src/crimewatch/settings.py for every option.
CW_APP_ENV=development          # production locks down login and Live Pulse
CW_AUTH_MODE=local              # oidc | local | none (none = dev laptop only, refused in production)
CW_USERS_FILE=config/users.json
CW_DATA_SOURCE=file             # file (real NCRB data) | synthetic (random demo)
CW_DATA_PATH=data/processed/dashboard_dataset.parquet
CW_AUDIT_LOG_PATH=logs/audit.jsonl
CW_SESSION_TIMEOUT_MIN=30
CW_MAX_LOGIN_ATTEMPTS=5
